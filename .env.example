# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. (.env 는 절대 공개 저장소에 올리지 마십시오.)
ANTHROPIC_API_KEY=여기에_API_키
# 번역에 사용할 모델 (생략 시 claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5
PORT=3000
# 접속 비밀번호(선택). 형식: 아이디:비밀번호
# BASIC_AUTH=admin:change-me
# IP당 분당 번역 횟수 제한 (기본 20)
# RATE_PER_MIN=20
# nginx 등 리버스 프록시 뒤에서 실행할 때 1
# TRUST_PROXY=1
